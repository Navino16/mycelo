{
  "name": "mycelo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "workspaces": [
    "packages/*",
    "fixtures/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc -p tsconfig.spec.json",
    "build": "tsc -b",
    "lint": "eslint .",
    "ci": "npm run lint && npm run typecheck && npm test",
    "start": "npm run build --workspace @mycelo/core && node packages/core/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
