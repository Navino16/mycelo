{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/test/**/*",
    "fixtures/*/src/**/*",
    "fixtures/*/test/**/*"
  ],
  "exclude": ["packages/ui/**"]
}
